# Shared-host settings for examples/shared-host (docs/deploying.md). Copy to .env, chmod 600, never commit it.

# Image: pin a version on a shared host (latest / rc also exist)
MCP_IMAGE_TAG=latest

# TLS (Caddy): the name clients use, and "internal" or your ACME e-mail address
MCP_HOSTNAME=mcp-ise.example.com
CADDY_TLS=internal

# The default ISE deployment: its Primary Admin node and a least-privilege account (docs/least-privilege.md)
ISE_URL=https://ise-pan.example.com
ISE_USERNAME=mcp-ro
ISE_PASSWORD=
# ISE_PASSWORD_FILE=/run/secrets/ise_password   # preferred: a Docker secret instead of a value here
# ISE_CA_BUNDLE=/certs/ise-ca.pem
# ISE_ERS_PORT=443

# More deployments (optional): each has its own URL, account, TLS and ERS port
# ISE_INSTANCES=dr
# ISE_DR_URL=https://ise-dr-pan.example.com
# ISE_DR_USERNAME=mcp-ro
# ISE_DR_PASSWORD=
# ISE_DR_READ_ONLY=true

# One token per person: ise-mcp-server token <name>, then paste the name:sha256:<hex> lines here
MCP_AUTH_TOKENS=

# Read-only unless you opt in. With writes on, MCP_ROLES decides who may use them (ro / rw / admin).
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_ROLES=alice:rw,bob:ro
