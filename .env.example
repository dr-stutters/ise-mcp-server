# Copy to .env (git-ignored, chmod 600) and fill in. Variable names only; never commit values.
ISE_URL=https://ise.example.com
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_SSL=true
# ISE_CA_BUNDLE=/path/to/ca.pem
# ISE_ERS_PORT=443            # 9060 on older releases / when ERS isn't enabled on 443
# ISE_TIMEOUT=30
# ISE_RETRIES=2
# ISE_RATE_LIMIT=             # requests per minute across all surfaces (unset = unlimited)
# ISE_MAX_CONCURRENCY=5
# ISE_PROBE_TIMEOUT=10        # per-surface timeout used by ise_status

# MCP server
# MCP_TRANSPORT=stdio         # or http
# MCP_AUTH_TOKENS=            # name:sha256:<hex>, required for http (ise-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CACHE_DIR=
# LOG_LEVEL=INFO
