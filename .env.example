# Copy to .env (git-ignored, chmod 600) and fill in. Variable names only; never commit values.
ISE_URL=https://ise.example.com
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_SSL=true
# ISE_CA_BUNDLE=/path/to/ca.pem
# ISE_ERS_PORT=443            # 9060 on older releases / when ERS isn't enabled on 443
# ISE_TIMEOUT=30
# ISE_RETRIES=2
# ISE_RATE_LIMIT=             # requests per minute across all surfaces (unset = unlimited)
# ISE_MAX_CONCURRENCY=5
# ISE_PROBE_TIMEOUT=10        # per-surface timeout used by ise_status
# ISE_DETAIL_THRESHOLD=100    # ERS list pages above this size skip per-item detail GETs
# ISE_DETAIL_CONCURRENCY=5    # concurrent per-item ERS GETs
# ISE_EXPORT_DIR=             # ise_export_config / ise_diff_config files live here (set it on a shared host)

# Guest accounts (I31): ERS guestuser runs as a sponsor, not the admin (docs/deploying.md, Guest sponsor)
# ISE_SPONSOR_USERNAME=       # sponsor in a sponsor group with guest REST API access
# ISE_SPONSOR_PASSWORD=       # or ISE_SPONSOR_PASSWORD_FILE / _REF
# ISE_SPONSOR_PORTAL=         # sponsor portal name or id (default: the only one / 'Sponsor Portal (default)')
# ISE_GUEST_TIMEZONE=         # IANA zone of the guest location, e.g. Europe/London

# MCP server
# MCP_TRANSPORT=stdio         # or http
# MCP_AUTH_TOKENS=            # name:sha256:<hex>, required for http (ise-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CACHE_DIR=
# LOG_LEVEL=INFO

# Least-privilege read-only account for tests/live/test_least_privilege.py (I16); see docs/least-privilege.md
# ISE_RO_USERNAME=
# ISE_RO_PASSWORD=

# Live-test inputs (tests/live; all optional, tests skip without them). See docs/live-tests.md.
# ISE_LIVE_SWITCH_MAC=52:54:00:12:34:56     # client behind a real switch (MAB)
# ISE_LIVE_SWITCH_IP=192.0.2.10             # that switch's NAS IP (optional check)
# ISE_LIVE_SWITCH_NAME=access-sw1           # switch name passed to the prompts
# ISE_LIVE_AD_JOIN_POINT=CORP               # a joined AD join point
# ISE_LIVE_AD_GROUP=corp.example.com/Groups/employees
# ISE_LIVE_AD_USER=alice                    # member of ISE_LIVE_AD_GROUP
# ISE_LIVE_CA_NAME=Example-Root-CA          # trusted CA that issued ISE's EAP / pxGrid certs
# ISE_LIVE_CA_PEM=/path/to/example-root-ca.pem
# ISE_LIVE_PXGRID_SIGNER=/path/to/sign-csr --template pxgrid   # CSR on stdin -> signed PEM on stdout
# ISE_LIVE_PXGRID_DOMAIN=example.com
# ISE_LIVE_DADM_NAD=access-sw1             # NAD with a TACACS+ secret; its device authorizes commands via ISE
# ISE_LIVE_DADM_HOST=192.0.2.10            # that device's SSH address (needs ssh + sshpass locally)
# ISE_LIVE_SXP_PEER=192.0.2.99              # unused address; nothing is contacted
# ISE_LIVE_SPONSOR_GROUP=guest-sponsors   # sponsor group of ISE_SPONSOR_USERNAME (guest live tests)
# ISE_LIVE_SCALE=1                          # opt in to the scale test
